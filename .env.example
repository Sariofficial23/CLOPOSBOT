# =============================================================================
#  BACKEND (apps/api) — Render Web Service + Cron Job
#  Copy to .env for local development. NEVER commit .env.
#  None of these may be exposed to the browser.
# =============================================================================

NODE_ENV=development
# Render sets PORT automatically; the server listens on 0.0.0.0:$PORT.
# Locally it falls back to 3001 when PORT is empty.
PORT=
LOG_LEVEL=info

DATABASE_URL=postgresql://clopos:clopos@localhost:5432/clopos

# Telegram (BotFather). TELEGRAM_MODE: webhook (Render) | polling (local) | off
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=polling
# 16-256 chars, A-Z a-z 0-9 _ -   (openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=

# Clopos Open API (https://developer.clopos.com). Credentials issued by Clopos.
# Base URL per the official docs (API v2):
CLOPOS_API_URL=https://integrations.clopos.com/open-api
CLOPOS_CLIENT_ID=
CLOPOS_CLIENT_SECRET=
CLOPOS_INTEGRATOR_ID=
# Reserved: Clopos docs do not (yet) document an OAuth redirect flow — see README.
CLOPOS_REDIRECT_URI=
# real = RealCloposService (required in production) | mock = MockCloposService (dev only)
CLOPOS_ADAPTER=mock

# openssl rand -hex 32  (min 32 chars)
JWT_SECRET=
JWT_EXPIRES_IN=12h
# 32 bytes, encrypts Clopos secrets/tokens at rest:  openssl rand -base64 32
ENCRYPTION_KEY=

# Comma separated list of allowed browser origins (CORS)
FRONTEND_URL=http://localhost:3000
# Public URL of this backend (used for the Telegram webhook)
BACKEND_URL=http://localhost:3001
# Default company timezone for seeding
TIMEZONE=Asia/Tashkent

RATE_LIMIT_MAX=300
REPORT_MAX_LAG_MINUTES=180

# Seed (pnpm db:seed). Required in production; dev defaults: admin@example.com / ChangeMe123!
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_TELEGRAM_ID=
SEED_COMPANY_NAME=

# Tests: separate database, truncated by the test suite
TEST_DATABASE_URL=postgresql://clopos:clopos@localhost:5432/clopos_test

# =============================================================================
#  FRONTEND (apps/web) — Vercel. Put these in apps/web/.env.local / Vercel.
#  Only NEXT_PUBLIC_* values reach the browser — never put secrets there.
# =============================================================================
# NEXT_PUBLIC_API_URL=http://localhost:3001
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
